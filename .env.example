# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — see includes/mailer.php and config/config.php.
#
# For a Gmail account: enable 2-Step Verification, then create an "App
# Password" (Google Account -> Security -> App passwords) and use that as
# SMTP_PASSWORD, not the normal account password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-address@gmail.com
SMTP_FROM_NAME="Student Q&A"
